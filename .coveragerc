[run]
# Coverage for the Django apps and the infra deploy scripts (both test suites run under coverage).
source = .
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */tests/*
    manage.py
    config/asgi.py
    config/wsgi.py
    .venv/*
    venv/*
    env/*

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
