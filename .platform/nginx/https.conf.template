server {
    listen 443 ssl;
    server_name __TLS_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/nyc-active-origin/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nyc-active-origin/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:NYCActiveTLS:1m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/nyc-active-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
    }
}
