{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyMediaRequestsWithoutHttps",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::nyc-active-media-287872994760-us-east-1",
        "arn:aws:s3:::nyc-active-media-287872994760-us-east-1/*"
      ],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
