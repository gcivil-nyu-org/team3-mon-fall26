{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTeamDatabaseBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nyc-active-db-backups-287872994760-us-east-1",
      "Condition": {"StringLike": {"s3:prefix": ["postgres/*"]}}
    },
    {
      "Sid": "ReadWriteOnlyTeamDatabaseBackups",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::nyc-active-db-backups-287872994760-us-east-1/postgres/*"
    }
  ]
}
